# ===================================================
#  Paparazzi-Worker — Credenciais e Configurações
#  Arquivo único de credenciais para todos os scripts.
#  (Repo fechado: versionado no git por escolha do projeto.)
# ===================================================

# --- YouTube Data API ---
# Usada por: detector.py e watcher.py (raiz e mirror-clips)
YOUTUBE_API_KEY=AIzaSyDXnyQUQuTrXAIuGsi46mzyYp29RlRto5g

# --- Twitter / X API ---
# Usada por: Modulo1_Twitter.py
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAABKK2QEAAAAAQZeWvqeP1Ji73OoVHh84rf2zhxM%3DX9MzWoEC98p2gk1nUU37pOcUlZifqcJpIRfhJTZigvQoseSdA3

# --- LLM local (Ollama) ---
# Usada por: roteirizador.py e coletor do mirror (legenda por IA)
LLM_API_URL=http://localhost:11434/api/generate
# Modelo do Ollama para gerar a legenda (pequeno/rápido em CPU)
LLM_MODEL=qwen2.5:3b

# ===================================================
#  TikTok — Módulo Mirror-Clips (poster.py)
# ===================================================

# --- TikTok API Oficial (Modo Preferencial) ---
# Obtenha em: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Nível de privacidade do post:
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Desabilitar comentários / duetos / stitch (true/false)
TIKTOK_DISABLE_COMMENT=false
TIKTOK_DISABLE_DUET=false
TIKTOK_DISABLE_STITCH=false

# --- TikTok Selenium (Modo em uso) ---
# SessionID do cookie de sessão do TikTok (F12 > Application > Cookies > tiktok.com > sessionid)
TIKTOK_SESSION_ID=ea19b2fef60c955445b1c3c0fa200cce

# Rodar o Chrome sem abrir janela (true = automático/servidor, false = ver a tela)
TIKTOK_HEADLESS=true

# Caminho para o Chrome/Chromium (deixe vazio para detecção automática)
CHROME_BINARY_PATH=

# --- Configurações Gerais do Mirror-Clips ---
# Pasta onde ficam os vídeos finais processados
MIRROR_OUTPUT_DIR=/mnt/paparazzi/mirror_clips

# Legenda padrão para os posts (pode usar {titulo} como variável)
DEFAULT_CAPTION=🔥 {titulo} #viral #shorts #trending #fyp

# Hashtags padrão (adicionadas no final do caption)
DEFAULT_HASHTAGS=#viral #fyp #shorts #trending
