# ===================================================
# Configurações do Módulo Mirror-Clips / TikTok Poster
# Copie este arquivo como .env e preencha os valores
# ===================================================

# --- TikTok API Oficial (Modo Preferencial) ---
# Obtenha em: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=sua_client_key_aqui
TIKTOK_CLIENT_SECRET=seu_client_secret_aqui
TIKTOK_ACCESS_TOKEN=seu_access_token_aqui
TIKTOK_REFRESH_TOKEN=seu_refresh_token_aqui

# Nível de privacidade do post:
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Desabilitar comentários / duetos / stitch (true/false)
TIKTOK_DISABLE_COMMENT=false
TIKTOK_DISABLE_DUET=false
TIKTOK_DISABLE_STITCH=false

# --- TikTok Selenium (Modo Fallback) ---
# SessionID do cookie de sessão do TikTok (capturado do navegador)
TIKTOK_SESSION_ID=seu_session_id_aqui

# Caminho para o Chrome/Chromium (deixe vazio para detecção automática)
CHROME_BINARY_PATH=

# --- Configurações Gerais ---
# Pasta onde ficam os vídeos finais processados
MIRROR_OUTPUT_DIR=/mnt/paparazzi/mirror_clips

# Legenda padrão para os posts (pode usar {titulo} como variável)
DEFAULT_CAPTION=🔥 {titulo} #viral #shorts #trending #fyp

# Hashtags padrão (adicionadas no final do caption)
DEFAULT_HASHTAGS=#viral #fyp #shorts #trending
